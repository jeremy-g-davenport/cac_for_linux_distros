#!/bin/bash
# tests/mocks/sudo — Strip sudo flags (-H -u <user>) and exec the remaining command.
# Allows lib functions that call `sudo -H -u "$REAL_USER" command ...` to invoke
# the certutil/modutil/etc. mocks in this directory without requiring real sudo.
while [[ $# -gt 0 ]]; do
    case "$1" in
        -H)  shift ;;
        -u)  shift; [[ $# -gt 0 ]] && shift ;;
        --)  shift; break ;;
        -*)  shift ;;
        *)   break ;;
    esac
done
[[ $# -eq 0 ]] && exit 0
exec "$@"
